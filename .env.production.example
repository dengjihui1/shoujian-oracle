GEMINI_API_KEY=
HOST=0.0.0.0
PORT=8000
TRUST_PROXY=true
STRUCTURED_LOGS=true
LOG_HASH_SALT=replace-with-a-long-random-value
REDIS_URL=redis://redis:6379
RATE_LIMIT_HASH_SALT=replace-with-another-long-random-value
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_UPSTREAM=16

# Optional Google Cloud TTS; keep disabled until credentials are configured.
GOOGLE_CLOUD_TTS_ENABLED=false
