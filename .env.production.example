GEMINI_API_KEY=
# Verified with a live request on 2026-09-27. Recheck account availability before launch.
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_GROUNDED_MODEL=gemini-3.1-flash-lite
# Keep the same cost tier in the pilot; an empty list disables automatic model upgrades.
GEMINI_FAST_FALLBACK_MODELS=
GEMINI_GROUNDED_FALLBACK_MODELS=
# Public support email or contact text shown in the page footer. No secrets here.
PUBLIC_CONTACT=
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
TRUST_PROXY=true
STRUCTURED_LOGS=true
LOG_HASH_SALT=replace-with-a-long-random-value
REDIS_URL=redis://redis:6379
RATE_LIMIT_HASH_SALT=replace-with-another-long-random-value
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_UPSTREAM=4
UPSTREAM_DEADLINE_MS=90000

# Shared admission units per Shanghai calendar month; NOT a CNY billing cap.
# Failures/local replies/cache hits also reserve units. 0 disables the guard.
# Keep the same Redis database; never delete its volume to reset usage.
MONTHLY_BUDGET_UNITS=1000
BUDGET_TEXT_UNITS=1
BUDGET_AUDIO_UNITS=5
# Disable all paid TTS/transcription (including Gemini fallbacks and STT WebSocket).
PAID_AUDIO_ENABLED=false

# Optional Google Cloud TTS; keep disabled until credentials are configured.
GOOGLE_CLOUD_TTS_ENABLED=false
# Optional Google Cloud Speech-to-Text streaming; requires ADC and a billed Cloud project.
GOOGLE_CLOUD_STT_ENABLED=false
