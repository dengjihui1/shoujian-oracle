# 从 https://aistudio.google.com/app/apikey 创建；不要提交真实密钥。
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
GEMINI_GROUNDED_MODEL=gemini-3.1-flash-lite
GEMINI_GROUNDED_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TIMEOUT_MS=60000
# 可选：配置后，“云端音色”自动改走 Google Cloud TTS；二选一即可。
# 推荐把服务账号 JSON 放在仓库外，并填写绝对路径。
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\你的用户名\.config\shoujian\service-account.json
# 使用 gcloud ADC 或云平台附加服务账号时，设置为 true。
# GOOGLE_CLOUD_TTS_ENABLED=true
# 也可使用只允许 Text-to-Speech API 的受限 API Key。
# GOOGLE_CLOUD_TTS_API_KEY=
# GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_TTS_LANGUAGE=cmn-CN
GOOGLE_CLOUD_TTS_VOICE=cmn-CN-Wavenet-B
GOOGLE_CLOUD_TTS_SPEAKING_RATE=0.92
GOOGLE_CLOUD_TTS_PITCH=-3
GOOGLE_CLOUD_TTS_SAMPLE_RATE=24000
GOOGLE_CLOUD_TTS_TIMEOUT_MS=20000
# 可选：任填一组即可作为 Gemini 文字对话的跨供应商兜底。
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=
# SILICONFLOW_API_KEY=
# SILICONFLOW_CHAT_MODEL=
# 任意 OpenAI-compatible 服务也可使用下面四项。
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://example.com/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_PROVIDER=compatible
# COMPATIBLE_TIMEOUT_MS=30000
# 中国大陆等无法直连 Google API 的网络环境可填写本机代理；能够直连时保持空白。
HTTPS_PROXY=
PORT=8000
