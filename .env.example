# 从 https://aistudio.google.com/app/apikey 创建；不要提交真实密钥。
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
GEMINI_GROUNDED_MODEL=gemini-3.1-flash-lite
GEMINI_GROUNDED_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TIMEOUT_MS=60000
# 可选：任填一组即可作为 Gemini 文字对话的跨供应商兜底；语音仍由 Gemini 负责。
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=
# SILICONFLOW_API_KEY=
# SILICONFLOW_CHAT_MODEL=
# 任意 OpenAI-compatible 服务也可使用下面四项。
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://example.com/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_PROVIDER=compatible
# COMPATIBLE_TIMEOUT_MS=30000
# 中国大陆等无法直连 Google API 的网络环境可填写本机代理；能够直连时保持空白。
HTTPS_PROXY=
PORT=8000
