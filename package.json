{
  "name": "shoujian-oracle",
  "version": "0.57.1",
  "private": true,
  "type": "module",
  "description": "A grounded Zhouyi RAG dialogue system with deterministic hexagram casting and a Gemini virtual diviner.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --use-env-proxy server/index.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "smoke:voice-browser": "node scripts/smoke-browser-voice.mjs",
    "eval:rag": "node scripts/evaluate-rag.mjs",
    "check": "node scripts/check-project.mjs",
    "vendor:calendar": "node scripts/vendor-calendar.mjs",
    "preflight": "node --env-file-if-exists=.env.production --env-file-if-exists=deploy/compose.env scripts/preflight.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@google-cloud/speech": "^8.1.0",
    "@google-cloud/text-to-speech": "^7.1.0",
    "lunar-javascript": "1.7.7",
    "opencc-js": "1.4.2",
    "redis": "6.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
